nhkantan.trading.minleverage=Min Leverage
nhkantan.trading.minleverage.tooltip=Default minimum leverage.
nhkantan.trading.defaultleverage=Default Leverage
nhkantan.trading.defaultleverage.tooltip=Leverage preselected in the trading UI.
nhkantan.trading.maxleverage=Max Leverage
nhkantan.trading.maxleverage.tooltip=Default maximum leverage.
nhkantan.trading.openfeepercent=Opening Fee (%%)
nhkantan.trading.openfeepercent.tooltip=Opening fee in percent of the notional position (margin x leverage).\n0 disables the fee.
nhkantan.trading.liquidationpercent=Liquidation Threshold (%%)
nhkantan.trading.liquidationpercent.tooltip=Unrealized loss, in percent of the initial margin, that triggers liquidation.\n100 liquidates when the loss equals the margin. 0 disables automatic liquidation.
nhkantan.trading.instrumentoverrides=Per-Stock Overrides
nhkantan.trading.instrumentoverrides.tooltip=One entry per stock: stockId;key=value;key=value\nKeys: maxOpenPositions, minLeverage, defaultLeverage, maxLeverage, openFeePercent, liquidationPercent\nExample: gtnh_index;maxLeverage=50;openFeePercent=0.1
nhkantan.currency=Currency
nhkantan.currency.tooltip=Market account currency.
nhkantan.currency.name=Currency Name
nhkantan.currency.name.tooltip=Display name of the market currency.
nhkantan.currency.initialbalance=Initial Balance
nhkantan.currency.initialbalance.tooltip=Balance of a newly created player account.
nhkantan.exchange=Exchange
nhkantan.exchange.tooltip=Exchange between market currency and items, and items accepted to repay debt.
nhkantan.exchange.currencyitems=Currency Items
nhkantan.exchange.currencyitems.tooltip=Items exchangeable with the market currency, one per entry:\nmodid:itemName;meta;depositValue;withdrawValue\n0 or negative value disables that direction (deposit-only or withdraw-only).
nhkantan.exchange.debtitems=Debt Repayment Items
nhkantan.exchange.debtitems.tooltip=Items accepted to repay a negative balance, one per entry: modid:itemName;meta;value\nvalue: market currency repaid per item. Repayment never raises the balance above 0.
nhkantan.compat=Compatibility
nhkantan.compat.tooltip=Integration with other mods.
nhkantan.compat.gtnhcoins=GTNH Coins
nhkantan.compat.gtnhcoins.tooltip=Adds the GTNH quest coins to the exchange and debt lists.\nEach coin type is listed once; all its sizes (1, 10, 100, 1000 and 10000 coins) are accepted.\nWithdrawals are paid out in the largest coins.
nhkantan.compat.gtnhcoindepositvalue=Coin Deposit Value
nhkantan.compat.gtnhcoindepositvalue.tooltip=Market currency credited per base coin. 0 or negative disables depositing.
nhkantan.compat.gtnhcoinwithdrawvalue=Coin Withdraw Value
nhkantan.compat.gtnhcoinwithdrawvalue.tooltip=Market currency charged per base coin. 0 or negative disables withdrawing.
nhkantan.compat.gtnhcoindebtvalue=Coin Debt Value
nhkantan.compat.gtnhcoindebtvalue.tooltip=Debt repaid per base coin. 0 or negative disables repaying with coins.
