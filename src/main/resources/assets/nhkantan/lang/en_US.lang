# Config GUI (GTNHLib, pattern %mod.%cat.%field; tooltips use .tooltip)
nhkantan.market=Market
nhkantan.market.tooltip=Price engine settings. Stocks and modes are defined in stocks.json and modes.json.
nhkantan.market.updateintervalticks=Update Interval (ticks)
nhkantan.market.updateintervalticks.tooltip=Server ticks between two price updates.\nPrices only advance while the server is running.
nhkantan.market.visiblecandles=Visible Candles
nhkantan.market.visiblecandles.tooltip=Number of K-line candles shown on displays and terminals; each price update is one candle.
nhkantan.trading=Trading
nhkantan.trading.tooltip=Margin trading rules. Values are defaults for every stock, see Per-Stock Overrides.
nhkantan.trading.maxopenpositionsperplayer=Max Positions per Player
nhkantan.trading.maxopenpositionsperplayer.tooltip=Maximum open positions per player across all stocks.
nhkantan.trading.maxopenpositionsperstock=Max Positions per Stock
